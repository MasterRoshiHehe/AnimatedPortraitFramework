{
  // PROPOSED replacement for assets/Patches/Caroline_Sweetheart/Caroline_Sweetheart.json
  // Included only when "Enable Caroline" + "Enable Childhood Sweetheart Caroline" are true.
  //
  // Design:
  //  - PORTRAITS: PWR-owned names (Portraits/Caroline_Sweetheart_X) so APF can map the suffix to its Sweetheart_ variants.
  //  - SPRITES: always the overhaul's asset names (Characters/Caroline_X).
  //      Overhaul installed  -> the overhaul loads them (its newer sheets, with frames 24/39/48-50 its events need).
  //      Overhaul missing    -> PWR loads its sorkrimp sheets into the same names.
  //  - APPEARANCE: mirrors the overhaul's conditions, one tier below each overhaul tier,
  //      so PWR wins in each tier and the specials still beat the seasons:
  //      PWR special -1110 < overhaul special -1100 < PWR season -140 < overhaul season -130.
  "Changes": [
    // ==========================================
    // 1. HD PORTRAIT SHEETS (PWR-owned names, used by the Appearance entries below)
    // ==========================================
    { "LogName": "CSC HD portrait Spring", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Spring", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Spring.png" },
    { "LogName": "CSC HD portrait Summer", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Summer", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Summer.png" },
    { "LogName": "CSC HD portrait Fall", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Fall", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Fall.png" },
    { "LogName": "CSC HD portrait Winter_Indoor", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Winter_Indoor", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Winter_Indoor.png" },
    { "LogName": "CSC HD portrait Winter_Indoor1", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Winter_Indoor1", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Winter_Indoor1.png" },
    { "LogName": "CSC HD portrait Winter_Outdoor", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Winter_Outdoor", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Winter_Outdoor.png" },
    { "LogName": "CSC HD portrait Aerobics", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Aerobics", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Aerobics.png" },
    { "LogName": "CSC HD portrait Beach", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_Beach", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_Beach.png" },
    { "LogName": "CSC HD portrait FlowerDance", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_FlowerDance", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_FlowerDance.png" },
    { "LogName": "CSC HD portrait SpiritsEve", "Action": "Load", "Target": "Portraits/Caroline_Sweetheart_SpiritsEve", "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_SpiritsEve.png" },
    {
      "LogName": "CSC HD portrait - Wedding",
      "Action": "Load",
      "Target": "Portraits/Caroline_Sweetheart_Wedding",
      "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/Caroline_.png"
    },

    // ==========================================
    // 2. SAFETY NET (overhaul installed): HD sheets on the overhaul's own portrait names.
    //    Covers `changePortrait Caroline FlowerDance` (DancePractice event) and any overhaul
    //    Appearance entry that still wins, so a 64px sheet never shows under RoshiHD_Template.
    //    Exclusive beats the overhaul's "High" loads. PWR file names already match 1:1.
    // ==========================================
    {
      "LogName": "CSC HD portraits over overhaul assets",
      "Action": "Load",
      "Priority": "Exclusive",
      "Target": "Portraits/Caroline_Spring, Portraits/Caroline_Summer, Portraits/Caroline_Fall, Portraits/Caroline_Winter_Indoor, Portraits/Caroline_Winter_Outdoor, Portraits/Caroline_Aerobics, Portraits/Caroline_Beach, Portraits/Caroline_FlowerDance, Portraits/Caroline_SpiritsEve",
      "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/{{TargetWithoutPath}}.png",
      "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "true" }
    },

    // ==========================================
    // 3. SPRITES - only when the overhaul is NOT installed (standalone / original sorkrim mod)
    //    Same asset names the overhaul uses, so the Appearance entries don't need a token.
    // ==========================================
    { "LogName": "CSC sprite Spring",         "Action": "Load", "Target": "Characters/Caroline_Spring",         "FromFile": "assets/Other_Sprites/sorkrimp/Spring.png",         "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite Summer",         "Action": "Load", "Target": "Characters/Caroline_Summer",         "FromFile": "assets/Other_Sprites/sorkrimp/Summer.png",         "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite Fall",           "Action": "Load", "Target": "Characters/Caroline_Fall",           "FromFile": "assets/Other_Sprites/sorkrimp/Fall.png",           "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite Winter Indoor",  "Action": "Load", "Target": "Characters/Caroline_Winter_Indoor",  "FromFile": "assets/Other_Sprites/sorkrimp/Winter_Indoor.png",  "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite Winter Outdoor", "Action": "Load", "Target": "Characters/Caroline_Winter_Outdoor", "FromFile": "assets/Other_Sprites/sorkrimp/Winter_Outdoor.png", "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite Aerobics",       "Action": "Load", "Target": "Characters/Caroline_Aerobics",       "FromFile": "assets/Other_Sprites/sorkrimp/Aerobics.png",       "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite FlowerDance",    "Action": "Load", "Target": "Characters/Caroline_FlowerDance",    "FromFile": "assets/Other_Sprites/sorkrimp/FlowerDance.png",    "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    { "LogName": "CSC sprite SpiritsEve",     "Action": "Load", "Target": "Characters/Caroline_SpiritsEve",     "FromFile": "assets/Other_Sprites/sorkrimp/SpiritsEve.png",     "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    // Caroline_Beach exists in vanilla, so edit it instead of loading it.
    { "LogName": "CSC sprite Beach",          "Action": "EditImage", "Target": "Characters/Caroline_Beach",     "FromFile": "assets/Other_Sprites/sorkrimp/beach.png",          "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false" } },
    // Winter_Indoor1 is PWR-only in both cases (the overhaul doesn't ship it).
    { "LogName": "CSC sprite Winter Indoor 1", "Action": "Load", "Target": "Characters/Caroline_Winter_Indoor1", "FromFile": "assets/Other_Sprites/sorkrimp/Winter_Indoor1.png" },

    // Base sheet (social tab, gift log, first frame of event actors) - the overhaul does its own "gift log fix".
    { "LogName": "CSC base sprite Spring (standalone)", "Action": "EditImage", "Target": "Characters/Caroline", "FromFile": "assets/Other_Sprites/sorkrimp/Spring.png", "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false", "Season": "spring" } },
    { "LogName": "CSC base sprite Summer (standalone)", "Action": "EditImage", "Target": "Characters/Caroline", "FromFile": "assets/Other_Sprites/sorkrimp/Summer.png", "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false", "Season": "summer" } },
    { "LogName": "CSC base sprite Fall (standalone)", "Action": "EditImage", "Target": "Characters/Caroline", "FromFile": "assets/Other_Sprites/sorkrimp/Fall.png", "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false", "Season": "fall" } },
    { "LogName": "CSC base sprite Winter (standalone)", "Action": "EditImage", "Target": "Characters/Caroline", "FromFile": "assets/Other_Sprites/sorkrimp/Winter_Outdoor.png", "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "false", "Season": "winter" } },

    // ==========================================
    // 4. APPEARANCE (Portrait + Sprite in EVERY entry - a null Sprite falls back to Characters/Caroline)
    // ==========================================
    {
      "LogName": "CSC Appearance",
      "Action": "EditData",
      "Target": "Data/Characters",
      "TargetField": ["Caroline", "Appearance"],
      "Entries": {
        // ---- Seasons (-140) ----
        "Roshi_CSC_Spring": {
          "Id": "Roshi_CSC_Spring", "Condition": "SEASON Spring",
          "Portrait": "Portraits/Caroline_Sweetheart_Spring", "Sprite": "Characters/Caroline_Spring",
          "Precedence": -140
        },
        "Roshi_CSC_Summer": {
          "Id": "Roshi_CSC_Summer", "Condition": "SEASON Summer",
          "Portrait": "Portraits/Caroline_Sweetheart_Summer", "Sprite": "Characters/Caroline_Summer",
          "Precedence": -140
        },
        "Roshi_CSC_Fall": {
          "Id": "Roshi_CSC_Fall", "Condition": "SEASON Fall",
          "Portrait": "Portraits/Caroline_Sweetheart_Fall", "Sprite": "Characters/Caroline_Fall",
          "Precedence": -140
        },
        // Indoors/Outdoors both default to TRUE, so each entry must turn the other one off.
        // The two indoor entries share a precedence; Weight 1 each = 50/50 daily roll (MP-safe day/save seed).
        "Roshi_CSC_WinterIndoor": {
          "Id": "Roshi_CSC_WinterIndoor", "Condition": "SEASON Winter", "Indoors": true, "Outdoors": false,
          "Portrait": "Portraits/Caroline_Sweetheart_Winter_Indoor", "Sprite": "Characters/Caroline_Winter_Indoor",
          "Precedence": -140, "Weight": 1
        },
        "Roshi_CSC_WinterIndoor1": {
          "Id": "Roshi_CSC_WinterIndoor1", "Condition": "SEASON Winter", "Indoors": true, "Outdoors": false,
          "Portrait": "Portraits/Caroline_Sweetheart_Winter_Indoor1", "Sprite": "Characters/Caroline_Winter_Indoor1",
          "Precedence": -140, "Weight": 1
        },
        "Roshi_CSC_WinterOutdoor": {
          "Id": "Roshi_CSC_WinterOutdoor", "Condition": "SEASON Winter", "Indoors": false, "Outdoors": true,
          "Portrait": "Portraits/Caroline_Sweetheart_Winter_Outdoor", "Sprite": "Characters/Caroline_Winter_Outdoor",
          "Precedence": -140
        },

        // ---- Specials (-1110) ----
        "Roshi_CSC_Aerobics": {
          "Id": "Roshi_CSC_Aerobics",
          "Condition": "LOCATION_NAME Target SeedShop, DAY_OF_WEEK Tuesday, WEATHER Target Sun Wind Snow",
          "Portrait": "Portraits/Caroline_Sweetheart_Aerobics", "Sprite": "Characters/Caroline_Aerobics",
          "Precedence": -1110
        },
        "Roshi_CSC_FlowerDance": {
          "Id": "Roshi_CSC_FlowerDance",
          "Condition": "EVENT_ID festival_spring24",
          "Portrait": "Portraits/Caroline_Sweetheart_FlowerDance", "Sprite": "Characters/Caroline_FlowerDance",
          "Precedence": -1110
        },
        "Roshi_CSC_SpiritsEve": {
          "Id": "Roshi_CSC_SpiritsEve",
          "Condition": "EVENT_ID festival_fall27",
          "Portrait": "Portraits/Caroline_Sweetheart_SpiritsEve", "Sprite": "Characters/Caroline_SpiritsEve",
          "Precedence": -1110
        },
        // Swimsuit where SHE is (no swimsuit at the town beach in winter). The overhaul checks where the PLAYER is instead (mirrored in section 5).
        "Roshi_CSC_Swim": {
          "Id": "Roshi_CSC_Swim",
          "Condition": "ANY \"LOCATION_NAME Target BathHouse_Entry BathHouse_WomensLocker BathHouse_Pool\" \"LOCATION_NAME Target Beach, !SEASON Winter\"",
          "Portrait": "Portraits/Caroline_Sweetheart_Beach", "Sprite": "Characters/Caroline_Beach",
          "Precedence": -1110
        },
        // Wedding event id is "-2" (Utility.getWeddingEvent). Frames 36-38 (wedding dress) live in every seasonal sheet.
        "Roshi_CSC_Wedding_Spring": {
          "Id": "Roshi_CSC_Wedding_Spring",
          "Condition": "EVENT_ID -2, SEASON Spring",
          "Portrait": "Portraits/Caroline_Sweetheart_Wedding", "Sprite": "Characters/Caroline_Spring",
          "Precedence": -1110
        },
        "Roshi_CSC_Wedding_Summer": {
          "Id": "Roshi_CSC_Wedding_Summer",
          "Condition": "EVENT_ID -2, SEASON Summer",
          "Portrait": "Portraits/Caroline_Sweetheart_Wedding", "Sprite": "Characters/Caroline_Summer",
          "Precedence": -1110
        },
        "Roshi_CSC_Wedding_Fall": {
          "Id": "Roshi_CSC_Wedding_Fall",
          "Condition": "EVENT_ID -2, SEASON Fall",
          "Portrait": "Portraits/Caroline_Sweetheart_Wedding", "Sprite": "Characters/Caroline_Fall",
          "Precedence": -1110
        },
        "Roshi_CSC_Wedding_Winter": {
          "Id": "Roshi_CSC_Wedding_Winter",
          "Condition": "EVENT_ID -2, SEASON Winter",
          "Portrait": "Portraits/Caroline_Sweetheart_Wedding", "Sprite": "Characters/Caroline_Winter_Outdoor",
          "Precedence": -1110
        },

        // ---- Island (-1120). IsIslandAttire entries are only considered while she wears island attire. ----
        "Roshi_CSC_Island": {
          "Id": "Roshi_CSC_Island",
          "IsIslandAttire": true,
          "Portrait": "Portraits/Caroline_Sweetheart_Beach", "Sprite": "Characters/Caroline_Beach",
          "Precedence": -1120
        }
      }
    },

    // ==========================================
    // 5. OVERHAUL MIRROR - the overhaul gives her the swimsuit while the PLAYER is at the beach/bathhouse
    //    (e.g. in its 14-heart BathLove event). Mirror it so PWR's portrait wins there too.
    // ==========================================
    {
      "LogName": "CSC Appearance - overhaul swim mirror",
      "Action": "EditData",
      "Target": "Data/Characters",
      "TargetField": ["Caroline", "Appearance"],
      "When": { "HasMod |contains=Solariaze.ChildhoodSweetheartCaroline": "true" },
      "Entries": {
        "Roshi_CSC_Swim_PlayerMirror": {
          "Id": "Roshi_CSC_Swim_PlayerMirror",
          "Condition": "PLAYER_LOCATION_UNIQUE_NAME Current Beach BathHouse_Entry BathHouse_WomensLocker BathHouse_Pool",
          "Portrait": "Portraits/Caroline_Sweetheart_Beach", "Sprite": "Characters/Caroline_Beach",
          "Precedence": -1110
        }
      }
    },

    // ==========================================
    // 6. DDFC
    // ==========================================
    {
      "LogName": "DDFC Assignment - Caroline",
      "Action": "EditData",
      "Target": "aedenthorn.DialogueDisplayFramework/dictionary",
      "Entries": {
        "Caroline": { "copyFrom": "RoshiHD_Template" }
      }
    }
  ]
}
